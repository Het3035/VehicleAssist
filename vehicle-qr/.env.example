# Copy this file to ".env" (same folder) and fill it in. Never share or commit ".env".
# Free email alerts using a Gmail account:
#  1. Turn on 2-Step Verification: https://myaccount.google.com/security
#  2. Create an App Password: https://myaccount.google.com/apppasswords  (16 letters)
#  3. Put your Gmail and that app password below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourname@gmail.com
SMTP_PASS=abcdefghijklmnop
# Optional: the name shown on emails
# SMTP_FROM=VehicleAssist <yourname@gmail.com>

# Optional: address phones use to reach this server (goes inside the QR codes)
# BASE_URL=http://192.168.1.20:3000

# ---- Admin page (optional). Open /admin to review reports, ban senders, remove accounts. ----
# Pick a long password. Leave this out to keep the admin page switched off.
# ADMIN_PASSWORD=choose-a-long-password

# ---- Daily backup (on by default, into the "backups" folder next to server.js) ----
# Better: a folder on ANOTHER drive or a OneDrive / Google Drive folder, so one dead disk cannot take both copies.
# BACKUP_DIR=E:\vehicle-backups
# BACKUP_KEEP=14

# ---- Privacy ----
# Shown on the privacy page as the address people write to about their data.
# CONTACT_EMAIL=you@example.com
# Alerts and chats older than this many days are deleted automatically (0 keeps them forever).
# MESSAGE_RETENTION_DAYS=90
# Different owners who must report the same sender before they are banned from every vehicle.
# AUTO_BAN_REPORTS=3

# Unread Emergency/Towing alerts are sent again to everyone on the vehicle after this many minutes (0 = off)
# ESCALATE_MINUTES=5
