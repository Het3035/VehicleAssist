# Copy this file to ".env" (same folder) and fill it in. Never share or commit ".env".
# Free email alerts using a Gmail account:
#  1. Turn on 2-Step Verification: https://myaccount.google.com/security
#  2. Create an App Password: https://myaccount.google.com/apppasswords  (16 letters)
#  3. Put your Gmail and that app password below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourname@gmail.com
SMTP_PASS=abcdefghijklmnop
# Optional: the name shown on emails
# SMTP_FROM=VehicleAssist <yourname@gmail.com>

# Optional: address phones use to reach this server (goes inside the QR codes)
# BASE_URL=http://192.168.1.20:3000
